          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article18\" group=\"Article\">\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n    <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"8\" step=\"1\">\n    <header>Show/Hide</header>\n    <input type=\"checkbox\" title=\"Title\" name=\"showMainTitle\" checked>\n    <input type=\"checkbox\" title=\"Subtitle\" name=\"showMainSubtitle\">\n    <input type=\"color\" name=\"iconColor\" title=\"Color\" value=\"#fcdbdb\">\n    <header>Background</header>\n    <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#ffffff\">\n  </mbr-parameters>\n  <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n    <div class=\"row justify-content-center\">\n      <div class=\"counter-container col-md-12 col-lg-{{textWidth}}\">\n        <div class=\"row mb-5 justify-content-center\" mbr-if=\"showMainTitle || showMainSubtitle\">\n          <div class=\"col-12 content-head\">\n            <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-5\" mbr-if=\"showMainTitle\" data-app-selector=\".mbr-section-title\"><b>FitSpresso </b>is marketed as a dietary supplement intended to support weight management and metabolic wellness. It may appeal to adults seeking to complement their daily health routines with a supplement alongside balanced nutrition and regular physical activity.</h3>\n            <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0 mt-4\" mbr-theme-style=\"display-7\" mbr-if=\"showMainSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n              Press \"Enter\" to add more items to the list.\n            </h5>\n          </div>\n        </div>\n        <div class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" data-multiline mbr-article>\n          <ul>\n            <li><b>Metabolic Support: </b>Designed to complement the body's natural metabolic processes as part of a healthy lifestyle.</li><li><b>Weight Management Support: </b>May be considered as an addition to a structured weight-management routine that includes healthy eating and exercise.</li><li><b>Everyday Wellness: </b>Fits into a broader approach to maintaining healthy daily habits and overall well-being.</li><li><b>Convenient Supplement Routine: </b>Offers an option for adults who prefer incorporating a dietary supplement into their existing wellness schedule.</li><li><b>Lifestyle Support:</b> Can complement sustainable habits such as regular movement, balanced meals, adequate hydration, and sufficient sleep.</li>\n            <li><b>Personal Wellness Goals: </b>May appeal to individuals looking for additional support while working toward realistic, long-term health goals.</li>\n          </ul>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>",
          "_anchor": "article18-6m",
          "_isUserblock": true,
          "_cid": "vb8qDNfHYU",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
